<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1080" Height="690" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#4C3C32" UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Paper" Color="#FFF8ED"/>
    <SolidColorBrush x:Key="Muted" Color="#918575"/>
    <Style TargetType="Button" x:Key="Quiet">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#69574B"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#F3E5D3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="Outline" BasedOn="{StaticResource Quiet}"><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FFFDF6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="#DBC7A8" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#F2E4D1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox" x:Key="Toggle">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="45"/><Setter Property="Height" Value="26"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Border x:Name="track" Background="#C6BDAE" CornerRadius="13"/><Ellipse x:Name="thumb" Fill="White" Width="20" Height="20" Margin="3,0" HorizontalAlignment="Left"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="#32A46B"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFDF7"/><Setter Property="BorderBrush" Value="#DDCDB5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#53493E"/></Style>
    <Style TargetType="ComboBox"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6"/><Setter Property="MinHeight" Value="32"/></Style>
  </UserControl.Resources>
  <Border x:Name="OuterBorder" CornerRadius="17" Background="{StaticResource Paper}" BorderBrush="#BFB4A1" BorderThickness="1" ClipToBounds="True">
    <Grid x:Name="Surface">
      <Grid.ColumnDefinitions><ColumnDefinition Width="642"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="Artwork" Grid.Column="0" ClipToBounds="True">
        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
        <TextBlock Text="回到你的彩虹岛" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="34" FontWeight="Bold" Foreground="White" Margin="67,216,0,0" VerticalAlignment="Top"><TextBlock.Effect><DropShadowEffect Color="#2383B8" BlurRadius="9" ShadowDepth="1" Opacity="0.6"/></TextBlock.Effect></TextBlock>
        <Border VerticalAlignment="Bottom" Background="#25293832" Padding="23,13"><TextBlock Text="非官方辅助启动器  ·  v1.0.0" Foreground="White" FontSize="11"/></Border>
      </Grid>
      <Grid Grid.Column="1" Background="{StaticResource Paper}">
        <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="#E8D9C2" BorderThickness="0,0,0,1" Background="#FFF5E4" x:Name="DragBar">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,9,0">
            <Button x:Name="SettingsButton" Style="{StaticResource Quiet}" Width="40" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" FontSize="18" ToolTip="设置" AutomationProperties.Name="设置"/>
            <Rectangle Width="1" Height="20" Fill="#E0CCAF" Margin="4,0"/>
            <Button x:Name="MinimizeButton" Style="{StaticResource Quiet}" Width="39" Content="—" FontSize="18" AutomationProperties.Name="最小化"/>
            <Button x:Name="CloseButton" Style="{StaticResource Quiet}" Width="39" Content="×" FontSize="25" AutomationProperties.Name="关闭启动器"/>
          </StackPanel>
        </Border>
        <Grid x:Name="HomePane" Grid.Row="1" Margin="25,0,25,0">
          <Grid.RowDefinitions><RowDefinition Height="111"/><RowDefinition Height="131"/><RowDefinition Height="65"/><RowDefinition Height="91"/><RowDefinition Height="115"/><RowDefinition Height="49"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="❧" Foreground="#9DB772" FontFamily="Georgia" FontSize="25" HorizontalAlignment="Center" Margin="0,-7,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="◦" Foreground="#DCBE8A" FontSize="33" Margin="0,0,18,0"/><TextBlock x:Name="HeadingText" Text="准备出发" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="38" FontWeight="Bold"/><TextBlock Text="◦" Foreground="#DCBE8A" FontSize="33" Margin="18,0,0,0"/></StackPanel>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="#DFCFB7" BorderThickness="1" CornerRadius="11" Background="#FFFCF5" Padding="15,12" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="StateDot" Width="13" Height="13" Fill="#31A967" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"/>
              <StackPanel Grid.Column="1"><TextBlock x:Name="StatusTitle" Text="准备就绪" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="StatusMessage" Text="选择好游戏目录，就可以出发了。" TextWrapping="Wrap" FontSize="11.5" Foreground="#897D6F" Margin="0,6,0,0" MaxHeight="48"/><TextBlock x:Name="CountdownText" FontSize="10.5" Foreground="#A07845" Margin="0,3,0,0" Visibility="Collapsed"/></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" BorderBrush="#E6D8C3" BorderThickness="1" CornerRadius="9" Padding="13,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="True"><CheckBox x:Name="CompatibilityToggle" Style="{StaticResource Toggle}" DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="繁体兼容模式"/><StackPanel><TextBlock Text="繁体兼容模式" FontSize="14"/><TextBlock Text="临时调整区域，完成后恢复" Foreground="#998A76" FontSize="10.5" Margin="0,2,0,0"/></StackPanel></DockPanel>
          </Border>
          <StackPanel Grid.Row="3" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal"><Path Data="M 1,5 L 1,17 L 19,17 L 19,5 L 9,5 L 7,2 L 1,2 Z" Stroke="#BE9454" StrokeThickness="1.5" Width="19" Height="18" Margin="2,0,10,0"/><TextBlock Text="游戏目录" FontSize="14"/></StackPanel>
            <Border BorderBrush="#DAC6A7" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,8,0,0"><DockPanel><Button x:Name="ChooseDirectoryButton" DockPanel.Dock="Right" Content="更改" Style="{StaticResource Outline}" Width="57" Margin="8,0,0,0"/><TextBox x:Name="DirectoryText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,7" VerticalAlignment="Center" FontSize="11.5" AutomationProperties.Name="游戏目录"/></DockPanel></Border>
          </StackPanel>
          <Button x:Name="LaunchButton" Grid.Row="4" Cursor="Hand" Margin="-6,3,-6,2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="启动游戏">
            <Button.Template><ControlTemplate TargetType="Button"><Grid x:Name="LaunchSurface"><Image x:Name="ButtonTexture" Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Stretch="Fill"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="LaunchIcon" Text="▶" FontSize="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,17,0"/><TextBlock x:Name="LaunchLabel" Text="启动游戏" FontSize="27" FontWeight="SemiBold" Foreground="White"/></StackPanel>
          </Button>
          <Border Grid.Row="5" BorderBrush="#E1CDAE" BorderThickness="0,1,0,0" Padding="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="LogsButton" Grid.Column="0" Style="{StaticResource Quiet}" AutomationProperties.Name="启动记录"><StackPanel Orientation="Horizontal"><Path Data="M 2,1 L 15,1 L 15,19 L 2,19 Z M 5,6 L 12,6 M 5,10 L 12,10 M 5,14 L 10,14" Stroke="#796453" StrokeThickness="1.4" Width="18" Height="20" Margin="0,0,10,0"/><TextBlock Text="启动记录" VerticalAlignment="Center"/></StackPanel></Button><Rectangle Grid.Column="1" Fill="#E1CDAE" Height="20"/><Button x:Name="OpenDirectoryButton" Grid.Column="2" Style="{StaticResource Quiet}" AutomationProperties.Name="打开游戏目录"><StackPanel Orientation="Horizontal"><Path Data="M 1,5 L 1,17 L 19,17 L 19,5 L 9,5 L 7,2 L 1,2 Z" Stroke="#796453" StrokeThickness="1.4" Width="20" Height="19" Margin="0,0,10,0"/><TextBlock Text="打开游戏目录" VerticalAlignment="Center"/></StackPanel></Button></Grid></Border>
          <StackPanel Grid.Row="6" VerticalAlignment="Center"><Button x:Name="CancelButton" Content="取消等待并恢复" Style="{StaticResource Quiet}" Foreground="#A7644B" Visibility="Collapsed" Padding="4,4"/><TextBlock x:Name="FooterText" Text="更新与登录由官方启动器完成" HorizontalAlignment="Center" FontSize="10.5" Foreground="#A89984" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <Grid x:Name="SettingsPane" Grid.Row="1" Margin="27,17,27,20" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><Button x:Name="SettingsBack" Style="{StaticResource Quiet}" Content="‹  返回" HorizontalAlignment="Left" Padding="0,5,15,5"/><TextBlock Text="启动器设置" FontSize="21" VerticalAlignment="Center"/></DockPanel>
          <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="等待游戏的最长时间" FontSize="13"/><ComboBox x:Name="WaitCombo" Margin="0,7,0,18"/>
            <TextBlock Text="游戏出现后的初始化等待" FontSize="13"/><ComboBox x:Name="SettleCombo" Margin="0,7,0,8"/><TextBlock Text="出现窗口后继续等待，再恢复系统区域。若仍偶发乱码，可以适当延长。" TextWrapping="Wrap" FontSize="11" Foreground="#94816A" Margin="0,0,0,20"/>
            <CheckBox x:Name="MinimizeCheck" Content="成功后收起到系统托盘" FontSize="13" Margin="0,0,0,22"/>
            <Border BorderBrush="#E2CFB1" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="关于兼容模式" FontSize="14"/><TextBlock Text="兼容模式沿用系统区域临时切换方式，实际效果取决于 Windows 与游戏版本；窗口出现不代表文字已验证。Win10 的乱码修复效果需要实机确认。" TextWrapping="Wrap" FontSize="11.5" Foreground="#96826B" Margin="0,8,0,0"/><TextBlock x:Name="SystemInfoText" TextWrapping="Wrap" FontSize="10.5" Foreground="#A3927B" Margin="0,13,0,0"/></StackPanel></Border>
            <Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Outline}" HorizontalAlignment="Left" Padding="20,10" Margin="0,23,0,0"/>
            <TextBlock x:Name="SettingsNote" Text="设置与日志保存在当前用户的本地应用数据目录。" TextWrapping="Wrap" FontSize="10.5" Foreground="#A2927D" Margin="0,14,0,0"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="LogsPane" Grid.Row="1" Margin="24,17,24,20" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
          <DockPanel><Button x:Name="LogsBack" Content="‹  返回" Style="{StaticResource Quiet}" Padding="0,5,15,5"/><TextBlock Text="启动记录" FontSize="21" VerticalAlignment="Center"/></DockPanel>
          <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" Margin="0,8,0,0" AutomationProperties.Name="启动日志"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="ExportLogsButton" Content="导出诊断日志" Style="{StaticResource Outline}"/><Button x:Name="OpenLogsButton" Content="打开日志目录" Style="{StaticResource Quiet}" Margin="10,0,0,0"/></StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
