<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1080" Height="690" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#4C3C32" UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Paper" Color="#FFF8ED"/>
    <SolidColorBrush x:Key="Muted" Color="#918575"/>
    <Style TargetType="Button" x:Key="Quiet">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#69574B"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#F3E5D3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="Outline" BasedOn="{StaticResource Quiet}"><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FFFDF6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="#DBC7A8" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#F2E4D1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button" x:Key="Coral" BasedOn="{StaticResource Quiet}">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="pink" CornerRadius="12" BorderThickness="1" BorderBrush="#F15D86"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF91AE" Offset="0"/><GradientStop Color="#FA547E" Offset="1"/></LinearGradientBrush></Border.Background><Border CornerRadius="10" BorderBrush="#FFFFEBEF" BorderThickness="1" Margin="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pink" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="pink" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox" x:Key="Toggle">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="45"/><Setter Property="Height" Value="26"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Border x:Name="track" Background="#C6BDAE" CornerRadius="13"/><Ellipse x:Name="thumb" Fill="White" Width="20" Height="20" Margin="3,0" HorizontalAlignment="Left"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="#32A46B"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFDF7"/><Setter Property="BorderBrush" Value="#DDCDB5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#53493E"/></Style>
    <Style TargetType="ComboBox"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6"/><Setter Property="MinHeight" Value="32"/></Style>
  </UserControl.Resources>
  <Border x:Name="OuterBorder" CornerRadius="17" Background="{StaticResource Paper}" BorderBrush="#BFB4A1" BorderThickness="1" ClipToBounds="True">
    <Grid x:Name="Surface">
      <Grid.ColumnDefinitions><ColumnDefinition Width="642"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="Artwork" Grid.Column="0" ClipToBounds="True">
        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
        <TextBlock Text="回到你的彩虹岛" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="34" FontWeight="Bold" Foreground="White" Margin="67,216,0,0" VerticalAlignment="Top"><TextBlock.Effect><DropShadowEffect Color="#2383B8" BlurRadius="9" ShadowDepth="1" Opacity="0.6"/></TextBlock.Effect></TextBlock>
        <Border VerticalAlignment="Bottom" Background="#90293832" Padding="23,9"><DockPanel><Button x:Name="UpdatesButton" DockPanel.Dock="Right" Content="更新与动态 ›" Style="{StaticResource Quiet}" Foreground="#FFF8ED" FontSize="11" Padding="10,5" AutomationProperties.Name="更新与动态"/><TextBlock x:Name="VersionText" Text="非官方辅助启动器" Foreground="White" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border>
      </Grid>
      <Grid Grid.Column="1" Background="{StaticResource Paper}">
        <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="#E8D9C2" BorderThickness="0,0,0,1" Background="#FFF5E4" x:Name="DragBar">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,9,0">
            <Button x:Name="AboutButton" Style="{StaticResource Quiet}" Width="40" FontFamily="Segoe MDL2 Assets" Content="&#xE946;" FontSize="18" ToolTip="关于与反馈" AutomationProperties.Name="关于与反馈"/>
            <Button x:Name="SettingsButton" Style="{StaticResource Quiet}" Width="40" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" FontSize="18" ToolTip="设置" AutomationProperties.Name="设置"/>
            <Rectangle Width="1" Height="20" Fill="#E0CCAF" Margin="4,0"/>
            <Button x:Name="MinimizeButton" Style="{StaticResource Quiet}" Width="39" Content="—" FontSize="18" AutomationProperties.Name="最小化"/>
            <Button x:Name="CloseButton" Style="{StaticResource Quiet}" Width="39" Content="×" FontSize="25" AutomationProperties.Name="关闭启动器"/>
          </StackPanel>
        </Border>
        <Grid x:Name="HomePane" Grid.Row="1" Margin="25,0,25,0">
          <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="155"/><RowDefinition Height="65"/><RowDefinition Height="91"/><RowDefinition Height="100"/><RowDefinition Height="49"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="❧" Foreground="#9DB772" FontFamily="Georgia" FontSize="25" HorizontalAlignment="Center" Margin="0,-7,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="◦" Foreground="#DCBE8A" FontSize="33" Margin="0,0,18,0"/><TextBlock x:Name="HeadingText" Text="准备出发" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="38" FontWeight="Bold"/><TextBlock Text="◦" Foreground="#DCBE8A" FontSize="33" Margin="18,0,0,0"/></StackPanel>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="#DFCFB7" BorderThickness="1" CornerRadius="11" Background="#FFFCF5" Padding="15,12" Margin="0,0,0,12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="49"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="StateDot" Width="13" Height="13" Fill="#31A967" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"/>
              <StackPanel Grid.Column="1"><TextBlock x:Name="StatusTitle" Text="准备就绪" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="StatusMessage" Text="选择好游戏目录，就可以出发了。" TextWrapping="Wrap" FontSize="10.5" Foreground="#897D6F" Margin="0,3,0,0" MaxHeight="27"/><TextBlock x:Name="CountdownText" FontSize="10" Foreground="#A07845" Margin="0,1,0,0" Visibility="Collapsed"/></StackPanel>
              <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#E4D5BD" BorderThickness="0,1,0,0" Padding="0,5,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button x:Name="RegionButton" Content="区域管理 ›" Style="{StaticResource Quiet}" Foreground="#278E64" FontSize="11.5" Padding="2,0" DockPanel.Dock="Right"/><TextBlock Text="当前系统区域" Foreground="#93816E" FontSize="10.5" VerticalAlignment="Center"/></DockPanel><DockPanel Grid.Row="1"><Border x:Name="HomeRegionBadge" DockPanel.Dock="Right" Background="#E4F1E4" CornerRadius="9" Padding="7,1" Margin="4,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="HomeRegionState" Text="检测中" FontSize="9.5" Foreground="#71876B"/></Border><TextBlock x:Name="HomeRegionText" Text="正在读取…" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Grid></Border>
            </Grid>
          </Border>
          <Border Grid.Row="2" BorderBrush="#E6D8C3" BorderThickness="1" CornerRadius="9" Padding="13,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="True"><CheckBox x:Name="CompatibilityToggle" Style="{StaticResource Toggle}" DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="繁体兼容模式"/><StackPanel><TextBlock Text="繁体兼容模式" FontSize="14"/><TextBlock x:Name="CompatibilityHint" Text="仅 Win11 · 临时调整区域，完成后恢复" Foreground="#998A76" FontSize="10.5" Margin="0,2,0,0"/></StackPanel></DockPanel>
          </Border>
          <StackPanel Grid.Row="3" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal"><Path Data="M 1,5 L 1,17 L 19,17 L 19,5 L 9,5 L 7,2 L 1,2 Z" Stroke="#BE9454" StrokeThickness="1.5" Width="19" Height="18" Margin="2,0,10,0"/><TextBlock Text="游戏目录" FontSize="14"/></StackPanel>
            <Border BorderBrush="#DAC6A7" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,8,0,0"><DockPanel><Button x:Name="ChooseDirectoryButton" DockPanel.Dock="Right" Content="更改" Style="{StaticResource Outline}" Width="57" Margin="8,0,0,0"/><TextBox x:Name="DirectoryText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,7" VerticalAlignment="Center" FontSize="11.5" AutomationProperties.Name="游戏目录"/></DockPanel></Border>
          </StackPanel>
          <Button x:Name="LaunchButton" Grid.Row="4" Cursor="Hand" Margin="-6,3,-6,2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="启动游戏">
            <Button.Template><ControlTemplate TargetType="Button"><Grid x:Name="LaunchSurface"><Image x:Name="ButtonTexture" Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Stretch="Fill"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="LaunchIcon" Text="▶" FontSize="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,17,0"/><TextBlock x:Name="LaunchLabel" Text="启动游戏" FontSize="27" FontWeight="SemiBold" Foreground="White"/></StackPanel>
          </Button>
          <Border Grid.Row="5" BorderBrush="#E1CDAE" BorderThickness="0,1,0,0" Padding="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="LogsButton" Grid.Column="0" Style="{StaticResource Quiet}" AutomationProperties.Name="启动记录"><StackPanel Orientation="Horizontal"><Path Data="M 2,1 L 15,1 L 15,19 L 2,19 Z M 5,6 L 12,6 M 5,10 L 12,10 M 5,14 L 10,14" Stroke="#796453" StrokeThickness="1.4" Width="18" Height="20" Margin="0,0,10,0"/><TextBlock Text="启动记录" VerticalAlignment="Center"/></StackPanel></Button><Rectangle Grid.Column="1" Fill="#E1CDAE" Height="20"/><Button x:Name="OpenDirectoryButton" Grid.Column="2" Style="{StaticResource Quiet}" AutomationProperties.Name="打开游戏目录"><StackPanel Orientation="Horizontal"><Path Data="M 1,5 L 1,17 L 19,17 L 19,5 L 9,5 L 7,2 L 1,2 Z" Stroke="#796453" StrokeThickness="1.4" Width="20" Height="19" Margin="0,0,10,0"/><TextBlock Text="打开游戏目录" VerticalAlignment="Center"/></StackPanel></Button></Grid></Border>
          <StackPanel Grid.Row="6" VerticalAlignment="Center"><Button x:Name="CancelButton" Content="取消等待并恢复" Style="{StaticResource Quiet}" Foreground="#A7644B" Visibility="Collapsed" Padding="4,4"/><TextBlock x:Name="FooterText" Text="更新与登录由官方启动器完成" HorizontalAlignment="Center" FontSize="10.5" Foreground="#A89984" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <Grid x:Name="RegionPane" Grid.Row="1" Margin="25,13,25,14" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="81"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Button x:Name="RegionBack" Content="‹  返回" Style="{StaticResource Quiet}" Foreground="#278E64" Padding="0,0,9,3" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Margin="0,0,0,9"><TextBlock Text="区域管理" FontFamily="KaiTi, Microsoft YaHei UI" FontWeight="Bold" FontSize="31" HorizontalAlignment="Center"/><TextBlock Text="非 Unicode 程序使用的系统区域" FontSize="11" Foreground="#958777" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Grid>
          <ScrollViewer x:Name="RegionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <StackPanel>
              <Border BorderBrush="#DFCFB7" BorderThickness="1" CornerRadius="10" Background="#FFFCF5" Padding="13,10" Margin="0,0,0,8"><StackPanel><DockPanel><Button x:Name="RegionRefreshButton" DockPanel.Dock="Right" Content="↻  重新检测" Style="{StaticResource Quiet}" Foreground="#278E64" Padding="0,1" FontSize="11"/><TextBlock Text="当前系统设置" FontSize="13" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="RegionCurrentText" Text="正在读取…" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,5" TextTrimming="CharacterEllipsis"/><DockPanel><Border x:Name="RegionBadge" DockPanel.Dock="Left" Background="#E4F1E4" CornerRadius="9" Padding="8,2" Margin="0,0,9,0"><TextBlock x:Name="RegionStateText" Text="检测中" FontSize="10.5"/></Border><TextBlock Text="系统已保存的设置" FontSize="10.5" Foreground="#998B79" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
              <Border BorderBrush="#DFCFB7" BorderThickness="1" CornerRadius="10" Background="#FFFCF5" Padding="13,10" Margin="0,0,0,9"><StackPanel><TextBlock x:Name="RegionBackupLabel" Text="最近一次启动前" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="RegionBackupText" Text="暂无有效备份" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,4" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RegionBackupTime" Text="首次兼容启动时会保存原设置。" FontSize="10.5" Foreground="#998B79"/><Button x:Name="RegionRestoreButton" Content="↻  恢复启动前原区域" Style="{StaticResource Coral}" Margin="0,10,0,0" AutomationProperties.Name="恢复启动前原区域"/></StackPanel></Border>
              <TextBlock x:Name="RegionResultText" FontSize="11" Foreground="#9F6841" TextWrapping="Wrap" Visibility="Collapsed" Margin="1,0,1,9"/>
              <Border BorderBrush="#E1CDAE" BorderThickness="0,1,0,0" Padding="0,10,0,0"><StackPanel><TextBlock Text="手动选择区域" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox x:Name="RegionCombo" MinHeight="34" AutomationProperties.Name="手动选择区域"><ComboBoxItem Content="中文（简体，中国）" Tag="zh-CN"/><ComboBoxItem Content="中文（繁体，台湾）" Tag="zh-TW"/></ComboBox><Button x:Name="RegionApplyButton" Content="应用所选区域" Style="{StaticResource Outline}" Margin="0,7,0,0" Padding="10,8"/><TextBlock x:Name="RegionAvailabilityText" FontSize="10.5" Foreground="#A27448" TextWrapping="Wrap" Visibility="Collapsed" Margin="1,5,1,0"/></StackPanel></Border>
              <Border Background="#FFF3D9" BorderBrush="#ECCD8B" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,8,0,10"><TextBlock Text="手动修改会保留，完整生效需要重启。&#10;不会自动重启电脑。" FontSize="10.5" Foreground="#92794F" LineHeight="17"/></Border>
              <Grid><Expander x:Name="RegionDetailsExpander" Header="检测详情" FontSize="11" Foreground="#278E64" VerticalAlignment="Top"><TextBlock x:Name="RegionDetailsText" TextWrapping="Wrap" FontSize="10.5" Foreground="#88765F" Margin="0,8,0,7"/></Expander><Button x:Name="WindowsRegionButton" HorizontalAlignment="Right" VerticalAlignment="Top" Content="Windows 区域设置 ↗" Style="{StaticResource Quiet}" FontSize="11" Foreground="#278E64" Padding="0,5"/></Grid>
              <Button x:Name="RegionLogsButton" Content="查看操作记录" Style="{StaticResource Quiet}" FontSize="11" HorizontalAlignment="Left" Foreground="#8B765C" Padding="0,5"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="SettingsPane" Grid.Row="1" Margin="27,17,27,20" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="89"/></Grid.RowDefinitions>
          <DockPanel><Button x:Name="SettingsBack" Style="{StaticResource Quiet}" Content="‹  返回" HorizontalAlignment="Left" Padding="0,5,15,5"/><TextBlock Text="启动器设置" FontSize="21" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0"><StackPanel Margin="0,0,5,0">
            <TextBlock Text="等待游戏的最长时间" FontSize="13"/><ComboBox x:Name="WaitCombo" Margin="0,7,0,18"/>
            <TextBlock Text="游戏出现后的初始化等待" FontSize="13"/><ComboBox x:Name="SettleCombo" Margin="0,7,0,8"/><TextBlock Text="出现窗口后继续等待，再恢复系统区域。若仍偶发乱码，可以适当延长。" TextWrapping="Wrap" FontSize="11" Foreground="#94816A" Margin="0,0,0,20"/>
            <CheckBox x:Name="MinimizeCheck" Content="成功后收起到系统托盘" FontSize="13" Margin="0,0,0,22"/>
            <Border BorderBrush="#E2CFB1" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="更新与项目动态" FontSize="14" Margin="0,0,0,12"/>
              <CheckBox x:Name="AutoCheckUpdates" Content="启动时自动检查更新（每天一次）" FontSize="12" Margin="0,0,0,10"/>
              <CheckBox x:Name="AutoDownloadUpdates" Content="发现新版后自动下载" FontSize="12" Margin="0,0,0,5"/>
              <TextBlock Text="下载后仍由你决定何时重启更新。" FontSize="10.5" Foreground="#94816A" Margin="20,0,0,12"/>
              <CheckBox x:Name="PreviewUpdates" Content="接收公开测试版更新" FontSize="12" Margin="0,0,0,10"/>
              <CheckBox x:Name="ShowAnnouncements" Content="显示项目动态" FontSize="12"/>
            </StackPanel></Border>
            <Border BorderBrush="#E2CFB1" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="关于兼容模式" FontSize="14"/><TextBlock Text="仅支持 Windows 11 64 位。启动前临时调整系统区域，完成后恢复原设置；切换期间可能影响其他非 Unicode 程序。Windows 10 暂不提供乱码修复。" TextWrapping="Wrap" FontSize="11.5" Foreground="#96826B" Margin="0,8,0,0"/><TextBlock x:Name="SystemInfoText" TextWrapping="Wrap" FontSize="10.5" Foreground="#A3927B" Margin="0,13,0,0"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
          <StackPanel Grid.Row="2"><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Outline}" HorizontalAlignment="Left" Padding="20,10" Margin="0,13,0,0"/><TextBlock x:Name="SettingsNote" Text="设置与日志保存在当前用户的本地应用数据目录。" TextWrapping="Wrap" FontSize="10.5" Foreground="#A2927D" Margin="0,10,0,0"/></StackPanel>
        </Grid>
        <Grid x:Name="UpdatesPane" Grid.Row="1" Margin="27,17,27,20" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><Button x:Name="UpdatesBack" Style="{StaticResource Quiet}" Content="‹  返回" Padding="0,5,15,5"/><TextBlock Text="更新与动态" FontSize="21" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer x:Name="UpdatesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <StackPanel Margin="0,0,4,0">
              <Border BorderBrush="#DFCFB7" BorderThickness="1" CornerRadius="11" Background="#FFFCF5" Padding="16,15"><StackPanel>
                <DockPanel><Button x:Name="CheckUpdateButton" Content="检查更新" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Foreground="#278E64" FontSize="11" Padding="2,2"/><TextBlock Text="启动器更新" FontSize="14" FontWeight="SemiBold"/></DockPanel>
                <TextBlock x:Name="UpdateVersionText" FontSize="23" FontWeight="SemiBold" Margin="0,11,0,4"/>
                <TextBlock x:Name="UpdateChannelText" FontSize="10.5" Foreground="#998B79"/>
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontSize="11.5" Foreground="#88765F" LineHeight="19" Margin="0,11,0,0"/>
                <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="7" Margin="0,12,0,0" Foreground="#32A46B" Visibility="Collapsed"/>
                <Button x:Name="CancelUpdateButton" Content="取消下载" Style="{StaticResource Quiet}" HorizontalAlignment="Right" FontSize="11" Visibility="Collapsed"/>
                <Border BorderBrush="#E8D9C2" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,12,0,0"><TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap" FontSize="12" LineHeight="21"/></Border>
                <Button x:Name="DownloadUpdateButton" Content="下载更新" Style="{StaticResource Coral}" Margin="0,15,0,0" Visibility="Collapsed"/>
                <DockPanel Margin="0,7,0,0"><Button x:Name="IgnoreUpdateButton" Content="忽略此版本" Style="{StaticResource Quiet}" FontSize="11" Foreground="#94816A" Padding="0,6" Visibility="Collapsed"/><Button x:Name="LaterUpdateButton" Content="稍后再说" Style="{StaticResource Quiet}" FontSize="11" HorizontalAlignment="Right" Padding="0,6"/></DockPanel>
              </StackPanel></Border>
              <Button x:Name="ReleasePageButton" Content="打开 GitHub 版本页面 ↗" Style="{StaticResource Quiet}" Foreground="#278E64" FontSize="11" HorizontalAlignment="Left" Padding="0,10"/>
              <TextBlock x:Name="UpdateResultText" TextWrapping="Wrap" FontSize="11" Foreground="#88765F" LineHeight="18" Margin="0,0,0,10"/>
              <Border BorderBrush="#E2CFB1" BorderThickness="0,1,0,0" Padding="0,15,0,0"><StackPanel>
                <TextBlock Text="项目动态" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="AnnouncementEmptyText" Text="暂时没有新的项目动态。" TextWrapping="Wrap" FontSize="11.5" Foreground="#998B79"/>
                <StackPanel x:Name="AnnouncementContent" Visibility="Collapsed">
                  <TextBlock x:Name="AnnouncementTitleText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="AnnouncementBodyText" TextWrapping="Wrap" FontSize="11.5" Foreground="#88765F" LineHeight="19" Margin="0,7,0,0"/>
                  <DockPanel Margin="0,5,0,0"><Button x:Name="AnnouncementLinkButton" Content="查看详情 ↗" Style="{StaticResource Quiet}" Foreground="#278E64" FontSize="11" Padding="0,7"/><Button x:Name="DismissAnnouncementButton" Content="已读，不再提示" Style="{StaticResource Quiet}" Foreground="#94816A" FontSize="11" HorizontalAlignment="Right" Padding="0,7"/></DockPanel>
                </StackPanel>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="LogsPane" Grid.Row="1" Margin="24,17,24,20" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
          <DockPanel><Button x:Name="LogsBack" Content="‹  返回" Style="{StaticResource Quiet}" Padding="0,5,15,5"/><TextBlock Text="启动记录" FontSize="21" VerticalAlignment="Center"/></DockPanel>
          <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" Margin="0,8,0,0" AutomationProperties.Name="启动日志"/>
          <Grid Grid.Row="2" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ExportLogsButton" Content="导出诊断日志" Style="{StaticResource Outline}"/><Button x:Name="OpenLogsButton" Grid.Column="1" Content="打开日志目录" Style="{StaticResource Quiet}" Padding="6,7"/><Button x:Name="FeedbackButton" Grid.Column="2" Content="反馈问题 ↗" Style="{StaticResource Quiet}" Foreground="#278E64" Padding="6,7"/></Grid>
        </Grid>
        <Grid x:Name="AboutPane" Grid.Row="1" Margin="27,17,27,20" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><Button x:Name="AboutBack" Style="{StaticResource Quiet}" Content="‹  返回" Padding="0,5,15,5"/><TextBlock Text="关于与反馈" FontSize="21" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <StackPanel>
              <Border BorderBrush="#DFCFB7" BorderThickness="1" CornerRadius="11" Background="#FFFCF5" Padding="18,19"><StackPanel><TextBlock Text="LaTale Garden" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="彩虹岛台服 · 非官方启动器" FontSize="12" Foreground="#918575" Margin="0,5,0,0"/><TextBlock Text="更方便地启动游戏，检查与恢复区域设置。" TextWrapping="Wrap" FontSize="12" Margin="0,17,0,0"/><TextBlock x:Name="AboutVersionText" FontSize="11" Foreground="#A3927B" Margin="0,12,0,0"/></StackPanel></Border>
              <Button x:Name="AboutUpdatesButton" Content="检查更新与查看动态 ›" Style="{StaticResource Outline}" Foreground="#278E64" Margin="0,12,0,0" Padding="12,10"/>
              <Border BorderBrush="#E2CFB1" BorderThickness="0,0,0,1" Padding="0,13,0,13" Margin="0,6,0,0"><DockPanel><Button x:Name="AboutAuthorButton" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Foreground="#278E64" Padding="7,5" AutomationProperties.Name="作者 visionki 的 GitHub 主页"/><StackPanel VerticalAlignment="Center"><TextBlock Text="作者与维护者" FontSize="13"/><TextBlock Text="在 GitHub 上查看作者" FontSize="10.5" Foreground="#A3927B" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
              <Button x:Name="AboutProjectButton" Content="GitHub 项目主页 ↗" Style="{StaticResource Outline}" HorizontalContentAlignment="Center" Margin="0,17,0,0" Padding="12,10"/>
              <TextBlock Text="使用中遇到问题？" FontSize="14" FontWeight="SemiBold" Margin="0,23,0,0"/>
              <TextBlock Text="欢迎通过 GitHub Issues 反馈问题或提出建议。请说明 Windows 版本、遇到的情况和操作步骤；也可以附上截图或诊断日志。" TextWrapping="Wrap" FontSize="11.5" Foreground="#918575" LineHeight="19" Margin="0,7,0,0"/>
              <Button x:Name="AboutFeedbackButton" Content="去 GitHub 反馈问题 ↗" Style="{StaticResource Coral}" Margin="0,12,0,0" Padding="12,9" FontSize="14"/>
              <Button x:Name="AboutLogsButton" Content="查看与导出诊断日志 ›" Style="{StaticResource Quiet}" Foreground="#278E64" HorizontalAlignment="Left" Padding="0,9" Margin="0,2,0,0"/>
              <TextBlock Text="独立维护的非官方辅助工具，与游戏运营方无隶属关系。游戏更新、登录与账号服务由官方提供。" TextWrapping="Wrap" FontSize="10.5" Foreground="#A3927B" LineHeight="17" Margin="0,14,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
