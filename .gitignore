# Public files are opt-in. Local notes, reports, settings and build outputs stay ignored.
/*
!/.gitattributes
!/.gitignore
!/*.cs
!/MainWindow.xaml
!/app.manifest
!/README.md
!/ASSETS.md
!/CHANGELOG.md
!/build.ps1
!/build-icon.ps1
!/check-public-files.ps1
!/prepare-update.ps1
!/sign-document.ps1
!/test.ps1
!/test-ui.ps1
!/test-updates.ps1
!/test-portable.ps1
!/test-published-update.ps1
!/test-update-install.ps1
!/test-region-live.ps1
!/Tests/
/Tests/*
!/Tests/*.cs
!/Assets/
/Assets/*
!/Assets/hero.png
!/Assets/launch-button.png
!/Assets/app-icon-source.png
!/Assets/app-icon.png
!/Assets/app.ico
!/Assets/update-public-key.xml
!/docs/
/docs/*
!/docs/RELEASING.md
!/docs/launcher-preview.png
!/docs/releases/
/docs/releases/*
!/docs/releases/v1.1.5.md
!/updates/
/updates/*
!/updates/updates.source.json
!/updates/updates.json
!/updates/announcements.source.json
!/updates/announcements.json
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.yml
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push
